<component type="desktop-application">
  <id>org.lumen.Lumen</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Lumen</name>
  <summary>Browse, rate, tag and lightly edit local photo folders</summary>
  <developer id="io.github.gauthampalaniappan">
    <name>Gautham Palaniappan</name>
  </developer>
  <description>
    <p>
      Lumen is a small photo organizer. Point it at folders you already have,
      browse a thumbnail grid, rate, tag and album your pictures, make light
      non-destructive edits, and build simple photobooks without ever rewriting
      your originals.
    </p>
    <ul>
      <li>Albums, 0–5 star ratings and tags, with search</li>
      <li>Live edit sliders with an RGB histogram; edits never touch the original</li>
      <li>Photobook export to PDF, and printing</li>
      <li>Import from memory cards and cameras, and incremental backups</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.lumen.Lumen.desktop</launchable>
